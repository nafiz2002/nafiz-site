# Template only. Copy to .env for local development (never commit .env).
# On Vercel, add these under Project > Settings > Environment Variables.

# --- Contact form (Resend, https://resend.com) --------------------------
# Without this the form shows a "not sent" state with a mailto fallback.
RESEND_API_KEY=
# Where messages go. Defaults to site.email in lib/site.ts.
CONTACT_TO=contact@nafizbasher.com
# Sender. Default "onboarding@resend.dev" only delivers to the Resend
# account's own email. After verifying nafizbasher.com in Resend, use e.g.
# CONTACT_FROM="Website <contact@nafizbasher.com>"
CONTACT_FROM=

# --- Commentary ---------------------------------------------------------
# Passphrase for /commentary/write. Required in production.
COMMENTARY_ADMIN_KEY=

# Database for Commentary. Any ONE of these works; leave the rest empty.
#
# (a) Vercel > Storage > Redis. Vercel injects <prefix>_REDIS_URL into the
#     project automatically (e.g. nafiz_commentary_REDIS_URL). For local
#     dev, `vercel env pull` writes it to .env.development.local.
# REDIS_URL=
#
# (b) Vercel > Storage > Upstash for Redis. Vercel injects these.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# With none set, posts are saved to data/commentary.json (local dev only).
